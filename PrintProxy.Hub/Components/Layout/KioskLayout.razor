@inherits LayoutComponentBase
@implements IDisposable
@inject EmergencyManager _EmergencyManager
@inject IDialogService Diag;

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-3">Printer Status</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    public bool emergency = false;

    IDialogReference dialog = null!;

    protected override Task OnInitializedAsync()
    {
        emergency = _EmergencyManager.GetState();
        _EmergencyManager.OnAlarm += Emergency;
        return base.OnInitializedAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (emergency)
            {
                Emergency(true);
            }
        }
        base.OnAfterRender(firstRender);
    }

    public async void Emergency(bool state)
    {
        emergency = state;
        if (emergency)
        {
            DialogOptions options = new()
                {
                    CloseButton = false,
                    BackdropClick = false,
                    CloseOnEscapeKey = false,
                    CloseOnNavigation = false,
                    FullWidth = true,
                    BackgroundClass = "mud-error",
                    NoHeader = true
                };

            dialog = await Diag.ShowAsync<EmergencyStopDiaglog>("Emergency stop",options);
        }
        else
        {
            if (dialog != null)
            {
              await InvokeAsync(dialog.Close);
            }
        }
    }

    public void Dispose()
    {
        _EmergencyManager.OnAlarm -= Emergency;
    }
}
