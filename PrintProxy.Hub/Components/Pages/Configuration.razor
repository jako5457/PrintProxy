@page "/config"
@inject IPrinterConfigurationService _configService;
@inject ISnackbar _snackbar;

<MudText Typo="Typo.h4" Class="mt-3">Configuration</MudText>

<MudCard Class="mt-5">
    <MudCardHeader>
        Flashforge
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@Config.Flashforge" ReadOnly="false" RowEditCommit="(_) => HaveChanges = true" CanCancelEdit="true">
            <ColGroup>
                <col style="width:50%;" />
                <col style="width:30%;" />
                <col style="width:20%;" />
            </ColGroup>
            <ToolBarContent>
                <MudText Typo="Typo.h6">Flashforge printers</MudText>
                <MudSpacer/>
                <MudButton OnClick="Save" >Save</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Printer Ip</MudTh>
                <MudTh>Checkcode</MudTh>
                <MudTh>Port</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Printer Ip">@context.PrinterIP</MudTd>
                <MudTd DataLabel="Checkcode">@context.CheckCode</MudTd>
                <MudTd DataLabel="Port">@context.Port</MudTd>
            </RowTemplate>
            <RowEditingTemplate>
                <MudTd DataLabel="Printer Ip">
                    <MudTextField @bind-Value="context.PrinterIP" Required />
                </MudTd>
                <MudTd DataLabel="Checkcode">
                    <MudTextField @bind-Value="context.CheckCode" Required />
                </MudTd>
                <MudTd DataLabel="Port">
                    <MudTextField InputMode="InputMode.numeric" @bind-Value="context.Port" Required />
                </MudTd>
            </RowEditingTemplate>
            <EditButtonContent Context="button">
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" Class="pa-0" OnClick="@button.ButtonAction" />
            </EditButtonContent>
        </MudTable>
    </MudCardContent>
</MudCard>

<MudCard Class="mt-5">
    <MudCardHeader>
        Octoprint
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@Config.Octoprint" ReadOnly="false" RowEditCommit="(_) => HaveChanges = true">
            <ColGroup>
                <col style="width:40%;" />
                <col style="width:60%;" />
            </ColGroup>
            <ToolBarContent>
                <MudText Typo="Typo.h6">Flashforge printers</MudText>
                <MudSpacer />
                <MudButton OnClick="Save">Save</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Endpoint</MudTh>
                <MudTh>Api key</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Printer Ip">@context.EndPoint</MudTd>
                <MudTd DataLabel="Api key">••••••••••••••••</MudTd>
            </RowTemplate>
            <RowEditingTemplate>
                <MudTd DataLabel="Printer Ip">
                    <MudTextField @bind-Value="context.EndPoint" Required />
                </MudTd>
                <MudTd DataLabel="Checkcode">
                    <MudTextField @bind-Value="context.ApiKey" Required />
                </MudTd>
            </RowEditingTemplate>
            <EditButtonContent Context="button">
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" Class="pa-0" OnClick="@button.ButtonAction" />
            </EditButtonContent>
        </MudTable>
    </MudCardContent>
</MudCard>

<MudCard Class="mt-5">
    <MudCardHeader>
        Moonraker
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@Config.Moonraker" ReadOnly="false" RowEditCommit="(_) => HaveChanges = true">
            <ColGroup>
                <col style="width:50%;" />
                <col style="width:50%;" />
            </ColGroup>
            <ToolBarContent>
                <MudText Typo="Typo.h6">Moonraker Printers</MudText>
                <MudSpacer />
                <MudButton OnClick="Save">Save</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>PrinterName</MudTh>
                <MudTh>EndPoint</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Printer Ip">@context.PrinterName</MudTd>
                <MudTd DataLabel="Checkcode">@context.Endpoint</MudTd>
            </RowTemplate>
            <RowEditingTemplate>
                <MudTd DataLabel="Printer Ip">
                    <MudTextField @bind-Value="context.PrinterName" Required />
                </MudTd>
                <MudTd DataLabel="Checkcode">
                    <MudTextField @bind-Value="context.Endpoint" Required />
                </MudTd>
            </RowEditingTemplate>
            <EditButtonContent Context="button">
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" Class="pa-0" OnClick="@button.ButtonAction" />
            </EditButtonContent>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {

    MainConfigEntry Config = new MainConfigEntry();

    bool HaveChanges = false;

    protected override async Task OnInitializedAsync()
    {
        Config = _configService.GetConfig();

        await base.OnInitializedAsync();
    }

    public async Task Save()
    {
        _configService.SaveConfig(Config);
        _snackbar.Add("Configuration updated", Severity.Success);
    }

}
