@page "/"
@inject IPrinterFactory PrinterFactory
@inject IPrinterIndexService index
@implements IDisposable
@inject EmergencyManager _EmergencyManager
@inject ILogger<Home> _logger;
@inject NavigationManager nav;

<PageTitle>Printer overview</PageTitle>
<MudButton Variant="Variant.Filled" OnClick="ReloadAsync" Color="Color.Primary" Style="margin-top:2px;">Refresh</MudButton>

<CascadingValue Value="UpdateDelegator">
    <MudGrid Style="margin-top:2px;">
        @foreach (var printer in Printers)
        {
            <PrintStatusWidget Printer="printer" DisableControls="Emergency" IsKiosk="false" />
        }
    </MudGrid>
</CascadingValue>


@code {
    
    public EventDelegator UpdateDelegator = new EventDelegator(); 
        
    bool isbusy = true;

    bool Emergency = false;

    public IEnumerable<IPrinter> Printers = new List<IPrinter>();

    protected override async Task OnInitializedAsync()
    {
        Printers = PrinterFactory.GetPrinters();
        _EmergencyManager.OnAlarm += emergency;
        await ReloadAsync();

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReloadAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
    
    public async void emergency(bool state)
    {
        await InvokeAsync(ReloadAsync);
    }
    
    public async Task ReloadAsync()
    {
        Emergency = _EmergencyManager.GetState();
        await InvokeAsync(StateHasChanged);
        await UpdateDelegator.SendEventAsync(this);
    }

    public void Dispose()
    {
        _EmergencyManager.OnAlarm -= emergency;
    }

}