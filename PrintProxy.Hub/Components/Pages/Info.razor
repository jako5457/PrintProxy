@page "/info"
@inject IPrinterFactory PrinterFactory
@inject ILogger<Home> _logger;
@implements IDisposable
@layout KioskLayout

<PageTitle>Info Screen</PageTitle>

<h5 style="height:10px; vertical-align:central; margin:5px; margin-bottom:0px">
    @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Style="margin-left:10px" Indeterminate="isbusy" />
</h5>
<CascadingValue Value="UpdateDelegator">
    <MudGrid Style="margin-top:2px;">
        @foreach (var printer in Printers)
        {
            <PrintStatusWidget Printer="printer" IsKiosk="true" />
        }
    </MudGrid>
</CascadingValue>


@code {

    public EventDelegator UpdateDelegator = new EventDelegator(); 
    
    bool isbusy = false;
    System.Timers.Timer timer = new(10000);
    
    
    public IEnumerable<IPrinter> Printers = new List<IPrinter>();

    protected override async Task OnInitializedAsync()
    {

        timer.Elapsed += (s, e) => InvokeAsync(ReloadAsync);    

        Printers = PrinterFactory.GetPrinters();

        await ReloadAsync();

        timer.Start();

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReloadAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task ReloadAsync()
    {
        await UpdateDelegator.SendEventAsync(this);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        timer.Stop();
        timer.Dispose();
    }

}