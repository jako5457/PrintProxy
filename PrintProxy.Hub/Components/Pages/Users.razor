@page "/users"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PrintProxy.Hub.Data
@inject UserManager<ApplicationUser> _UserManager
@inject ISnackbar _Snackbar;

@attribute [Authorize(Roles = "admin")]
<MudTable Items="@users" ReadOnly="true">
                    <ColGroup>
                        <col style="width:80%;" />
                        <col style="width:20%;" />
                    </ColGroup>
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Users</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Username</MudTh>
                        <MudTh>Admin</MudTh>
                    </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Printer Ip">@context.User.UserName</MudTd>
                            <MudTd>
                                @if (context.User.UserName != "admin")
                                {

                                    <MudSwitch T="bool" ValueChanged="@(async e => await ChangeAdminPermissionAsync(context,e))" Value="@context.IsAdmin"  UncheckedColor="Color.Error" Color="Color.Success" />
                                }
                                else
                                {
                                    <MudSwitch Disabled="true" Value="true" title="You cant remove admin from admin" UncheckedColor="Color.Error" Color="Color.Success" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

@code {

    List<UserEntry> users = new();
    
    protected override async Task OnInitializedAsync()
    {
        users = await _UserManager.Users.Select(u => new UserEntry() { User = u }).ToListAsync();

        foreach (var user in users)
        {
            if (user.User.UserName != "admin")
            {
               user.IsAdmin = await _UserManager.IsInRoleAsync(user.User, "admin");
            }
        }
        
        await base.OnInitializedAsync();
        
    }

    public async Task ChangeAdminPermissionAsync(UserEntry entry,bool newValue)
    {
        if (entry.IsAdmin != newValue)
        {
            entry.IsAdmin = newValue;
        }

        if (entry.IsAdmin)
        {
            await _UserManager.AddToRoleAsync(entry.User, "admin");
        }
        else
        {
            
        }
        
        _Snackbar.Add($"User {entry.User.UserName} has been updated", Severity.Success);
    }
    
    public class UserEntry
    {
        public ApplicationUser User { get; set; }
        
        public bool IsAdmin { get; set; }
    }
    
}