
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Add new Flashforge printer
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (ValidationErrors.Any())
        {
            <MudList T="string">
                @foreach (var item in ValidationErrors)
                {
                    <MudListItem Text="@item" />
                }
            </MudList>
        }
        <MudTextField @bind-Value="@model.Name" Label="Name" />
        <MudTextField @bind-Value="@model.IpAddress" Label="Printer IP" />
        <MudTextField @bind-Value="@model.SerialNumber" Label="Serial Number" />
        <MudTextField @bind-Value="@model.AcessCode" Label="Access code" />
        <MudSwitch @bind-Value="@model.DevMode" Label="Developer mode" UncheckedColor="Color.Error" Color="Color.Success" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="CreatePrinter">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    List<string> ValidationErrors = new();

    BambuPrinterModel model = new();

    public void Cancel() => MudDialog.Cancel();

    public void CreatePrinter()
    {
        ValidationErrors.Clear();

        Uri uri = default!;

        if (string.IsNullOrEmpty(model.Name))
        {
            ValidationErrors.Add("Name is required");
        }

        if (string.IsNullOrEmpty(model.IpAddress))
        {
            ValidationErrors.Add("Ip address is required");
        }

        if (string.IsNullOrEmpty(model.SerialNumber))
        {
            ValidationErrors.Add("Serialnumber is required");
        }

        if (string.IsNullOrEmpty(model.AcessCode))
        {
            ValidationErrors.Add("Access code is required");
        }

        if (ValidationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        BambuLabOptions options = new()
        {
            PrinterName = model.Name,
            PrinterIP = model.IpAddress,
            SerialNunber = model.SerialNumber,
            AccessCode = model.AcessCode,
            DevMode = model.DevMode
        };
        MudDialog.Close(options);
    }

    private class BambuPrinterModel
    {
        public string Name { get; set; } = string.Empty;

        public string IpAddress { get; set; } = string.Empty;

        public string SerialNumber { get; set; } = string.Empty;

        public string AcessCode { get; set; } = string.Empty;

        public bool DevMode { get; set; } = false;
    };
}
