@using PrintLib.Moonraker

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Add new Octoprint printer
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (ValidationErrors.Any())
        {
            <MudList T="string">
                @foreach (var item in ValidationErrors)
                {
                    <MudListItem Text="@item" />
                }
            </MudList>
        }
        <MudTextField @bind-Value="@model.Name" Label="Name" />
        <MudTextField @bind-Value="@model.Endpoint" Label="Endpoint" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="CreatePrinter">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    public void Cancel() => MudDialog.Cancel();

    List<string> ValidationErrors = new();

    bool UriValid = true;

    MoonrakerPrinterModel model = new MoonrakerPrinterModel();

    public void CreatePrinter()
    {
        ValidationErrors.Clear();

        Uri uri = default!;
        UriValid = Uri.TryCreate(model.Endpoint, UriKind.Absolute, out uri);

        if (!UriValid)
        {
            ValidationErrors.Add("Endpoint is invalid");
        }

        if (string.IsNullOrEmpty(model.Name))
        {
            ValidationErrors.Add("Name is required");
        }

        if (ValidationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        MoonrakerOptions options = new()
        {
            Endpoint = model.Endpoint,
            PrinterName = model.Name,
        };
        MudDialog.Close(options);

    }

    private class MoonrakerPrinterModel
    {
        public string Name { get; set; } = string.Empty;

        public string Endpoint { get; set; } = string.Empty;
    };
}

