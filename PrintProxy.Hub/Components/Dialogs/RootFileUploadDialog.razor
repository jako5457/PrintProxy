@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inject IAppDataService _SiteRootService

<MudContainer>
    @if (Uploading)
    {
        <MudText>Uploading file....</MudText>
    }
    else
    {
        <MudFileUpload @bind-Files=_file DragAndDrop="true" Accept=".png,.jpg,.svg"></MudFileUpload>

        <MudButton Variant="Variant.Filled" color="Color.Primary" Class="mt-2 mb-2" OnClick="() => UploadAsync()">Upload file</MudButton>
        <MudButton Variant="Variant.Filled" color="Color.Error" Class="mt-2 mb-2" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
    }
</MudContainer>

    @code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private IBrowserFile _file;

    [Parameter]
    public string Directory { get; set; } = string.Empty;

    public MudFileUpload<IBrowserFile> fileupload;

    public bool Uploading = false;

    public async Task UploadAsync()
    {
        Uploading = true;
        await InvokeAsync(StateHasChanged);

        if(string.IsNullOrWhiteSpace(Directory))
        {
            string result = await _SiteRootService.WriteFileAsync(_file.OpenReadStream(8000000000), _file.Name,Directory);
            MudDialog.Close(result);
        }
        else
        {
            string result = await _SiteRootService.WriteFileAsync(_file.OpenReadStream(8000000000), _file.Name);
            MudDialog.Close(result);
        }
    }

}
