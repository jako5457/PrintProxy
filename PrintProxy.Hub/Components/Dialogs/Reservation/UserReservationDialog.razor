@using Microsoft.AspNetCore.Identity
@using PrintProxy.Hub.Data
@using PrintProxy.Hub.Services.Dto
@using PrintProxy.Hub.Services.reservation
@inject IReservationService ReservationService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject IPrinterIndexService IndexService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        @if (EditMode)
        {
            @:Edit Reservation
        }
        else
        {
            @:Create Reservation
        }
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Errors="errors">
            @if (errors.Any())
            {
                <MudText Typo="Typo.subtitle2">@($"Errors ({errors.Length})")</MudText>
                @foreach (var error in errors)
                {
                    <MudText Color="@Color.Error">@error</MudText>
                }
            }

            <MudSelect T="PrinterModel" Disabled="EditMode" MultiSelection="true" SelectAll="true" SelectAllText="All Printers" @bind-SelectedValues="Model.SelectedPrinters">
                @foreach (var printer in Printers)
                {
                    <MudSelectItem T="PrinterModel" Value="printer">@printer.PrinterName</MudSelectItem>
                }
            </MudSelect>
            <MudGrid>
                <MudItem md="6">
                    <MudDatePicker Label="Start date" @bind-Date="Model.StartDate"/>
                </MudItem>
                <MudItem md="6">
                    <MudDatePicker Label="End date" @bind-Date="Model.EndDate"/>
                </MudItem>
            </MudGrid>
            <MudGrid>
                <MudItem md="6">
                    <MudTimePicker Label="Start time" @bind-Time="Model.StartTime"/>
                </MudItem>
                <MudItem md="6">
                    <MudTimePicker Label="End time" @bind-Time="Model.EndTime"/>
                </MudItem>
            </MudGrid>
            <MudTextField Label="Title" Required="true" RequiredError="Title needs to be filled" @bind-Value="Model.Title"/>
            <MudTextField Label="Description (Optional)" Required="false" @bind-Value="Model.Description"/>
            <MudGrid>
                <MudItem>

                </MudItem>
                <MudItem>

                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" @onclick="SubmitAsync">
            @if (EditMode)
            {
                @:Save
            }
            else
            {
                @:Create
            }
            
        </MudButton>
        <MudButton Color="Color.Secondary" @onclick="() => MudDialog.Cancel()">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public ReservationInfoDto? Reservation { get; set; } = null!;

    [Parameter] 
    public bool EditMode { get; set; } = false;
    
    string[] errors = [];
    List<string> NewErrors = new();
    private MudForm _form;
    
    ReservationModel Model { get; set; } = new ReservationModel();
    
    List<PrinterModel> Printers = new List<PrinterModel>();
    
    protected override async Task OnInitializedAsync()
    {
        Printers = await IndexService.GetPrintersAsync();
        
        if (EditMode)
        {
            
            Model = new ReservationModel()
            {
                SelectedPrinters = Printers
                    .Where(p => p.PrinterId == (Reservation?.PrinterId ?? -1) )
                    .Select(p => new PrinterModel()
                    {
                        PrinterId = p.PrinterId,
                        PrinterName = p.PrinterName,
                    }).ToList(),
                Title = Reservation.Title,
                Description = Reservation.Description,
                StartDate = Reservation.StartDate,
                EndDate = Reservation.EndDate,
                StartTime = Reservation.StartDate.TimeOfDay,
                EndTime = Reservation.EndDate.TimeOfDay
            };
        }
        
        await base.OnInitializedAsync();
    }
    
    public async Task SubmitAsync()
    {
        if (errors.Length == NewErrors.Count())
        {
            NewErrors.Clear();
            errors = NewErrors.ToArray();
        }
        
        if (errors.Any())
        {
            return;
        }
        
        DateTime startDate = Model.StartDate.GetValueOrDefault().Date.Add(Model.StartTime.GetValueOrDefault());
        DateTime endDate = Model.EndDate.GetValueOrDefault().Date.Add(Model.EndTime.GetValueOrDefault());

        foreach (var printer in Model.SelectedPrinters)
        {
            bool Isvalid = false;
            if (EditMode)
            {
                Isvalid = await ReservationService.ValidateValidReservationWithReservationAsync(Reservation,startDate,endDate);
            }
            else
            {
                Isvalid = await ReservationService.ValidateValidReservationAsync(printer.PrinterId,startDate, endDate);
            }
            
            if (!Isvalid)
            {
                NewErrors.Add($"{ printer.PrinterName } - There is a reservation overlap with another reservation");
            }
        }
        
        bool valid = !NewErrors.Any();
        
        List<EditReservationDto> NewReservations = new();
        
        if (valid)
        {
            if (EditMode)
            {
                var reservation = new EditReservationDto()
                {
                    Title = Model.Title,
                    Description = Model.Description,
                    StartDate = startDate,
                    EndDate = endDate,
                };
                
                await ReservationService.EditReservationAsync(reservation,Reservation.ReservationId);
                Snackbar.Add("Reservation changed", Severity.Success);
            }
            else
            {
                var AuthState = await AuthProvider.GetAuthenticationStateAsync();
                var user = await UserManager.FindByNameAsync(AuthState.User.Identity?.Name);
                
                foreach (var printer in Model.SelectedPrinters)
                {
                    var reservation = new EditReservationDto()
                    {
                        UserId = user.Id,
                        PrinterId = printer.PrinterId,
                        Title = Model.Title,
                        Description = Model.Description,
                        StartDate = startDate,
                        EndDate = endDate,
                    };
                    NewReservations.Add(reservation);
                }
                
                await ReservationService.CreateReservationsAsync(NewReservations);
                Snackbar.Add("Reservations Created", Severity.Success);
            }
            
            
            MudDialog.Close();
        }
        
        if (NewErrors.Any())
        {
            errors = NewErrors.ToArray();
        }
    }
    
    private class ReservationModel
    {
        public IReadOnlyCollection<PrinterModel> SelectedPrinters { get; set; } = new List<PrinterModel>();
        
        public string Title { get; set; }
        
        public string Description { get; set; }
        
        public DateTime? StartDate { get; set; }    
        
        public DateTime? EndDate { get; set; }
        
        public TimeSpan? StartTime { get; set; }
        
        public TimeSpan? EndTime { get; set; }
    }
}