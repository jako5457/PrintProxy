@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inject IPrinterConfigurationService configService
@inject ISnackbar snackbar

<MudContainer>
    @if (Uploading)
    {
        <MudText>Uploading Config</MudText>
    }
    else
    {
        <MudFileUpload @bind-Files=_file DragAndDrop="true" Accept=".json"></MudFileUpload>

        <MudButton Variant="Variant.Filled" color="Color.Primary" Class="mt-2 mb-2" OnClick="() => UploadAsync()">Upload files</MudButton>
        <MudButton Variant="Variant.Filled" color="Color.Error" Class="mt-2 mb-2" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
    }
</MudContainer>


@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private IBrowserFile _file;

    public MudFileUpload<IBrowserFile> fileupload;

    public bool Uploading = false;

    public async Task UploadAsync()
    {
        Uploading = true;
        await InvokeAsync(StateHasChanged);

        var stream = _file.OpenReadStream();

        byte[] bytes = new byte[stream.Length];
        
        await stream.ReadAsync(bytes, 0, (int)stream.Length);
        
        string json =  Encoding.UTF8.GetString(bytes);

        if (string.IsNullOrEmpty(json))
        {
            snackbar.Add("Config file empty", Severity.Error);
            Uploading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        
        var mainConfigEntry = JsonConvert.DeserializeObject<MainConfigEntry>(json);

        if (mainConfigEntry == null)
        {
            snackbar.Add("Config Invalid", Severity.Error);
            Uploading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        
        configService.SaveConfig(mainConfigEntry);

        MudDialog.Close();
    }

}